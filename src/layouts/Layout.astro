---
// src/layouts/Layout.astro
const { title = "Hypoaqua" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <style is:global>
    /* ================= 1. 注册 B2 字体 ================= */
    @font-face { font-family: 'Andada Pro'; src: url('https://f005.backblazeb2.com/file/hypoaqua/AndadaPro-Regular.otf') format('opentype'); font-display: swap; }
    @font-face { font-family: 'LXGW Heart Serif'; src: url('https://f005.backblazeb2.com/file/hypoaqua/LXGWHeartSerifCHS-2.ttf') format('truetype'); font-display: swap; }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { 
      min-height: 100vh; 
      font-family: "Andada Pro", "LXGW Heart Serif", "Kaiti SC", system-ui, sans-serif; 
      color: #1e293b; position: relative; overflow: hidden; 
      background: url('https://f005.backblazeb2.com/file/hypoaqua/back.jpg') center/cover no-repeat fixed;
      background-color: #f8fafc;
    }

    /* ================= 2. 顶部导航 (无视频，直接显示) ================= */
    .top-bar { 
      position: fixed; top: 0; width: 100%; height: 60px; z-index: 50; 
      display: flex; justify-content: space-between; align-items: center; 
      padding: 0 2rem; 
      background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); 
      border-bottom: 1px solid rgba(42, 96, 167, 0.1); 
      opacity: 0; transition: opacity 0.5s ease-out;
    }
    .top-bar.show { opacity: 1; }

    .nav-left { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 0.1rem; }
    .logo-text { font-family: "Andada Pro", serif; font-size: 1rem; font-weight: bold; letter-spacing: 0.2em; color: #2A60A7; cursor: pointer; }
    .copyright-text { font-size: 0.6rem; color: #94a3b8; white-space: nowrap; }
    
    .nav-right { display: flex; align-items: center; gap: 1.5rem; font-size: 0.75rem; color: #64748b; }
    .nav-right a { color: #2A60A7; text-decoration: none; font-weight: bold; }

    .lang-switch {
      background: rgba(42, 96, 167, 0.1); border: 1px solid rgba(42, 96, 167, 0.2);
      color: #2A60A7; padding: 0.3rem 0.8rem; border-radius: 20px;
      font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 0.75rem;
    }
    .lang-switch:hover { background: #2A60A7; color: #fff; }

    /* ================= 3. 全局悬浮音乐球 ================= */
    #floating-music-widget {
      position: fixed; bottom: 30px; right: 30px; z-index: 99999;
      display: flex; flex-direction: column; align-items: center; gap: 10px;
      opacity: 0; pointer-events: none; transition: opacity 0.5s ease;
    }
    #floating-music-widget.show { opacity: 1; pointer-events: auto; }

    /* 太极球：点击播放/暂停 */
    .music-orb { 
      width: 60px; height: 60px; border-radius: 50%; 
      background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(12px); 
      border: 2px solid rgba(255, 255, 255, 0.8); cursor: pointer; 
      display: flex; justify-content: center; align-items: center; 
      box-shadow: 0 10px 20px rgba(0,0,0,0.1); 
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
      position: relative; overflow: hidden; 
    }
    .music-orb:hover { transform: scale(1.1); box-shadow: 0 0 30px rgba(22, 163, 74, 0.4); }
    .music-orb::before { 
      content: ''; position: absolute; inset: 0; 
      background: linear-gradient(135deg, rgba(42, 96, 167, 0.8) 50%, rgba(22, 163, 74, 0.8) 50%); 
      opacity: 0.3; z-index: 0; 
    }
    .music-orb svg { width: 30px; height: 30px; z-index: 1; color: #fff; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2)); }

    /* 歌名文字：拖拽与点击 */
    .music-marquee { 
      width: 120px; text-align: center; font-size: 0.75rem; color: #2A60A7; font-weight: 600; 
      background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(4px); 
      padding: 4px 8px; border-radius: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; 
      box-shadow: 0 4px 10px rgba(0,0,0,0.05); 
      cursor: grab; pointer-events: auto; touch-action: none;
      transition: 0.2s; 
    }
    .music-marquee:active { cursor: grabbing; }
    .music-marquee:hover { background: #fff; color: #16A34A; }

    @media (max-width: 768px) {
      .top-bar { padding: 0 1rem; }
      .nav-right a { display: none; } 
      #floating-music-widget { bottom: 20px; right: 15px; }
      .music-orb { width: 50px; height: 50px; }
      .music-orb svg { width: 24px; height: 24px; }
      .music-marquee { width: 90px; font-size: 0.65rem; }
    }
  </style>
</head>
<body>
  <!-- 顶部导航 -->
  <header class="top-bar show" id="main-nav">
    <div class="nav-left">
      <div class="logo-text">HYPOAQUA</div>
      <div class="copyright-text" id="copyright-text">© All rights reserved.</div>
    </div>
    <div class="nav-right">
      <a href="mailto:underwater@hypoaqua.com">underwater@hypoaqua.com</a>
      <button class="lang-switch" id="lang-btn">EN</button>
    </div>
  </header>

  <!-- 全局悬浮太极球 -->
  <div id="floating-music-widget">
    <div class="music-orb" id="orb-play-btn" title="播放/暂停">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" id="orb-icon-path"/></svg>
    </div>
    <div class="music-marquee" id="orb-song-name" title="拖拽移动，点击打开列表">等待播放</div>
  </div>

  <audio id="global-audio"></audio>
  <slot />

  <script>
    // --- 1. 语言切换 ---
    window.currentLang = 'zh'; 
    window.updateLanguage = () => {};

    document.getElementById('lang-btn').addEventListener('click', (e) => {
      window.currentLang = window.currentLang === 'zh' ? 'en' : 'zh';
      e.target.textContent = window.currentLang === 'zh' ? 'EN' : '中';
      document.getElementById('copyright-text').textContent = window.currentLang === 'zh' ? '© 保留所有权利' : '© All rights reserved.';
      if (window.updateLanguage) window.updateLanguage();
    });

    // --- 2. 悬浮球点击播放/暂停 ---
    const audioPlayer = document.getElementById('global-audio');
    const orbPlayBtn = document.getElementById('orb-play-btn');

    orbPlayBtn.addEventListener('click', () => {
      if (!audioPlayer.src) { 
        if (window.openMusicModal) window.openMusicModal(); 
        return; 
      }
      if (audioPlayer.paused) audioPlayer.play(); 
      else audioPlayer.pause();
    });

    // 监听全局音频状态，同步图标
    audioPlayer.addEventListener('play', () => {
      document.getElementById('orb-icon-path').setAttribute('d', 'M6 19h4V5H6v14zm8-14v14h4V5h-4z');
    });
    audioPlayer.addEventListener('pause', () => {
      document.getElementById('orb-icon-path').setAttribute('d', 'M8 5v14l11-7z');
    });

    // 供 index.astro 更新歌名
    window.updateMusicWidget = (isPlaying, songName) => {
      const w = document.getElementById('floating-music-widget');
      const m = document.getElementById('orb-song-name');
      if (songName) { w.classList.add('show'); m.textContent = songName; }
    };

    // --- 3. 歌名拖拽逻辑 ---
    const widget = document.getElementById('floating-music-widget');
    const dragHandle = document.getElementById('orb-song-name');
    
    let isDragging = false;
    let startX, startY, initialLeft, initialTop;

    dragHandle.addEventListener('pointerdown', (e) => {
      isDragging = false;
      
      const rect = widget.getBoundingClientRect();
      widget.style.bottom = 'auto'; 
      widget.style.right = 'auto';
      widget.style.left = rect.left + 'px'; 
      widget.style.top = rect.top + 'px';
      
      startX = e.clientX; 
      startY = e.clientY; 
      initialLeft = rect.left; 
      initialTop = rect.top;
      
      dragHandle.setPointerCapture(e.pointerId);
    });

    dragHandle.addEventListener('pointermove', (e) => {
      if (e.buttons === 0) return;
      const dx = e.clientX - startX; 
      const dy = e.clientY - startY;
      
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
        isDragging = true;
      }
      
      if (isDragging) { 
        widget.style.left = initialLeft + dx + 'px'; 
        widget.style.top = initialTop + dy + 'px'; 
      }
    });

    dragHandle.addEventListener('pointerup', () => {
      setTimeout(() => { isDragging = false; }, 50);
    });

    // --- 4. 歌名点击打开音乐列表 ---
    dragHandle.addEventListener('click', () => {
      if (isDragging) return; 
      if (window.openMusicModal) window.openMusicModal();
    });
  </script>
</body>
</html>
---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hypoaqua Works">
  <main class="app-container">
    <section class="view-section active" id="view-home">
      <div class="block-grid" id="home-cards"></div>
    </section>
  </main>

  <div id="mega-modal" class="mega-modal-overlay">
    <div class="mega-modal-content">
      <button id="close-mega-modal" class="close-mega-btn">×</button>
      <h2 id="modal-title" class="mega-title"></h2>
      
      <div id="mega-list-container" class="shutter-container"></div>
      
      <!-- 音乐播放器区 -->
      <div id="mega-music-player" class="music-player-hidden">
        <div class="jukebox">
          <div class="selector-bar">
            <label for="music-select" id="music-label">选择曲目：</label>
            <select id="music-select"></select>
          </div>
          <div class="jukebox-visual">
            <button id="play-pause-btn" class="speaker-horn"><svg viewBox="0 0 100 100" class="horn-icon"><path d="M20,40 L40,40 L70,15 L70,85 L40,60 L20,60 Z" fill="currentColor" /><path d="M 75 30 Q 85 50 75 70" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><path d="M 82 20 Q 95 50 82 80" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></button>
            <div class="vinyl-record" id="vinyl"><div class="vinyl-center"></div></div>
          </div>
          <div class="jukebox-bottom">
            <div class="status-row"><span id="current-time">00:00</span><span id="total-time">00:00</span></div>
            <input type="range" id="progress-bar" value="0" min="0" max="100" step="0.1">
          </div>
        </div>
      </div>

      <!-- 阅读器区 -->
      <div id="reader-view" class="reader-hidden">
        <button id="back-to-list" class="back-to-list-btn">← 返回列表</button>
        <div class="epub-wrapper">
          <div id="loading" class="loading-overlay"><div class="spinner"></div><p>Loading...</p></div>
          <div id="viewer"></div>
          <div class="epub-controls">
            <button id="prev-btn" class="stamp-btn green">返</button>
            <div class="right-controls"><button id="next-btn" class="stamp-btn blue">翻</button></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 独立的详情弹窗 -->
  <div id="detail-modal" class="mega-modal-overlay" style="z-index: 300; background: rgba(10, 22, 40, 0.7);">
    <div class="mega-modal-content" style="width: 80vw; max-width: 600px; height: auto; max-height: 80vh; padding: 2.5rem; border-radius: 30px;">
      <button id="close-detail-modal" class="close-mega-btn">×</button>
      <h2 id="detail-title" class="mega-title" style="margin-bottom: 1rem; text-align: left;"></h2>
      <div id="detail-desc" style="color: #475569; line-height: 1.8; overflow-y: auto; max-height: 50vh; padding-right: 10px;"></div>
      <button id="detail-read-btn" class="read-btn" style="display: none; margin-top: 1.5rem; width: 100%;">开始阅读</button>
    </div>
  </div>
</Layout>

<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  .app-container { position: absolute; top: 60px; left: 0; width: 100vw; height: calc(100vh - 60px); overflow: hidden; }
  .view-section { position: absolute; inset: 0; display: flex; justify-content: center; align-items: center; z-index: 10; }

  /* 太极图四板块 */
  .block-grid { 
    position: relative; 
    width: 400px; 
    height: 400px; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    margin: 0 auto; 
    border-radius: 50%; 
    overflow: hidden; 
    box-shadow: 0 0 50px rgba(42, 96, 167, 0.15); 
  }
  @media (max-width: 768px) { .block-grid { width: 300px; height: 300px; } }

  /* 扇形基础外观 */
  .glass-block { 
    position: absolute; 
    width: 100%; 
    height: 100%; 
    background: rgba(255, 255, 255, 0.15); 
    backdrop-filter: blur(12px); 
    border: 1px solid rgba(255, 255, 255, 0.3); 
    transition: background 0.3s, box-shadow 0.3s, opacity 0.4s; 
    opacity: 0; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    cursor: pointer; 
    text-decoration: none; 
    pointer-events: auto; 
  }
  
  .leaf-pop { animation: popInLeaf 1s forwards; }
  @keyframes popInLeaf { 0% { opacity: 0; transform: scale(0.8); } 100% { opacity: 1; transform: scale(1); } }

  /* 标准的上下左右 90 度扇形 */
  .shape-top { clip-path: polygon(0 0, 100% 0, 50% 50%); }
  .shape-right { clip-path: polygon(100% 0, 100% 100%, 50% 50%); }
  .shape-bottom { clip-path: polygon(100% 100%, 0 100%, 50% 50%); }
  .shape-left { clip-path: polygon(0 100%, 0 0, 50% 50%); }

  /* 内容排版 */
  .block-content { 
    position: relative; 
    z-index: 1; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    text-align: center; 
    color: #1e293b; 
    width: 50%; 
    transition: transform 0.3s;
    text-shadow: 0 1px 3px rgba(255,255,255,0.8);
  }
  
  /* 文字向正上、正右、正下、正左边缘推 */
  .shape-top .block-content { transform: translateY(-100%); }
  .shape-right .block-content { transform: translateX(100%); }
  .shape-bottom .block-content { transform: translateY(100%); }
  .shape-left .block-content { transform: translateX(-100%); }

  /* 图标和文字放大 */
  .block-icon svg { width: 36px; height: 36px; stroke: #2A60A7; margin-bottom: 0.5rem; }
  .block-title { font-family: "Andada Pro", "LXGW Heart Serif", serif; font-size: 1.6rem; font-weight: 700; margin: 0; color: #2A60A7; letter-spacing: 0.1em; }
  
  /* 👇 悬浮强调光：只亮当前扇形，通过内阴影实现 */
  .glass-block:hover { 
    background: rgba(255, 255, 255, 0.4); 
    box-shadow: inset 0 0 60px rgba(22, 163, 74, 0.3); 
    z-index: 10; 
  }
  /* 弹窗 */
  .mega-modal-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(248, 250, 252, 0.6); backdrop-filter: blur(15px); display: flex; justify-content: center; align-items: center; opacity: 0; pointer-events: none; transition: opacity 0.4s; }
  .mega-modal-overlay.active { opacity: 1; pointer-events: auto; }
  .mega-modal-content { position: relative; width: 90vw; max-width: 1000px; height: 85vh; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(20px); border: 2px solid rgba(255, 255, 255, 0.9); border-radius: 40px; box-shadow: 0 30px 80px rgba(42, 96, 167, 0.2); display: flex; flex-direction: column; padding: 3rem; overflow: hidden; transform: translateY(30px); transition: all 0.5s; }
  .mega-modal-overlay.active .mega-modal-content { transform: translateY(0); }

  .close-mega-btn { position: absolute; top: 1.5rem; right: 1.5rem; width: 45px; height: 45px; border-radius: 50%; background: rgba(0,0,0,0.05); border: none; font-size: 1.8rem; color: #64748b; cursor: pointer; transition: 0.3s; z-index: 10; }
  .close-mega-btn:hover { background: #ef4444; color: #fff; }
  .mega-title { font-size: 2.2rem; color: #2A60A7; font-weight: 800; margin-bottom: 2rem; text-align: center; }

  .shutter-container { flex: 1; overflow-y: auto; padding-right: 1rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .shutter-item { width: 100%; min-height: 100px; padding: 2rem; cursor: pointer; border-radius: 20px; background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(240,250,255,0.6)); border: 1px solid rgba(255, 255, 255, 0.9); box-shadow: 0 10px 30px rgba(42, 96, 167, 0.08); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; transition: 0.3s; }
  .shutter-item:hover { transform: translateY(-5px); border-color: #16A34A; box-shadow: 0 15px 40px rgba(22, 163, 74, 0.15); }
  
  .item-title { font-size: 1.8rem; font-weight: 800; color: #2A60A7; margin-bottom: 0.5rem; }
  .item-subtitle { font-size: 1rem; color: #16A34A; font-weight: 600; }

  .read-btn { background: #2A60A7; color: #fff; border: none; padding: 0.8rem; border-radius: 20px; font-size: 1rem; font-weight: bold; cursor: pointer; transition: 0.3s; }
  .read-btn:hover { background: #16A34A; }

  /* 音乐播放器 */
  .music-player-hidden { display: none; flex: 1; justify-content: center; align-items: center; }
  .music-player-hidden.show { display: flex; }
  .jukebox { width: 100%; max-width: 600px; height: 100%; max-height: 500px; background: rgba(255, 255, 255, 0.4); border-radius: 30px; display: flex; flex-direction: column; overflow: hidden; }
  .selector-bar { padding: 1.5rem; background: rgba(255, 255, 255, 0.5); display: flex; flex-direction: column; align-items: center; gap: 0.8rem; }
  select { width: 80%; padding: 0.8rem; font-size: 1rem; border-radius: 20px; border: 1px solid #cbd5e1; outline: none; }
  .jukebox-visual { flex: 1; display: flex; justify-content: space-around; align-items: center; }
  .speaker-horn { width: 100px; height: 100px; color: #94a3b8; cursor: pointer; border: none; background: transparent; }
  .vinyl-record { width: 120px; height: 120px; border-radius: 50%; background: repeating-radial-gradient(#f8fafc, #f8fafc 2px, #e2e8f0 3px, #f8fafc 4px); display: flex; justify-content: center; align-items: center; animation: spin 4s linear infinite; animation-play-state: paused; }
  .vinyl-record.playing { animation-play-state: running; }
  .vinyl-center { width: 30px; height: 30px; background: #16A34A; border-radius: 50%; }
  @keyframes spin { 100% { transform: rotate(360deg); } }
  .jukebox-bottom { background: rgba(255, 255, 255, 0.8); padding: 1.5rem; }
  .status-row { display: flex; justify-content: space-between; font-family: monospace; margin-bottom: 0.5rem; }
  input[type="range"] { width: 100%; cursor: pointer; }

  /* 阅读器区 */
  .reader-hidden { display: none; position: absolute; inset: 0; background: #f8fafc; z-index: 20; padding: 2rem; flex-direction: column; }
  .reader-hidden.show { display: flex; }
  .back-to-list-btn { align-self: flex-start; background: transparent; border: 1px solid #cbd5e1; padding: 0.4rem 1.2rem; border-radius: 20px; cursor: pointer; margin-bottom: 1rem; }
  .epub-wrapper { position: relative; width: 100%; height: 100%; background: #fff; border-radius: 20px; overflow: hidden; display: flex; flex-direction: column; }
  #viewer { flex: 1; width: 100%; }
  .loading-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fff; }
  .spinner { width: 40px; height: 40px; border: 3px solid #e2e8f0; border-top-color: #2A60A7; border-radius: 50%; animation: spin 1s linear infinite; }
  .epub-controls { height: 60px; display: flex; justify-content: space-between; align-items: center; padding: 0 1.5rem; border-top: 1px solid #e2e8f0; }
  .stamp-btn { width: 45px; height: 45px; border-radius: 50%; border: none; color: #fff; cursor: pointer; font-weight: bold; }
  .stamp-btn.green { background: #16A34A; }
  .stamp-btn.blue { background: #2A60A7; }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/epubjs/dist/epub.min.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    
    // ================= 1. 全局配置与语言字典 =================
    window.currentLang = 'zh'; 
    window.updateLanguage = () => {};

    const I18N = {
      zh: { 
        lit: { title: '文学' }, 
        pub: { title: '出版' }, 
        mus: { title: '音乐' }, 
        gam: { title: '游戏' }, 
        read: '开始阅读', chooseSong: '选择曲目：' 
      },
      en: { 
        lit: { title: 'Literature' }, 
        pub: { title: 'Published' }, 
        mus: { title: 'Music' }, 
        gam: { title: 'Games' }, 
        read: 'Start Reading', chooseSong: 'Select a track:' 
      }
    };

    // ================= 2. 主页面太极四瓣渲染 =================
    function renderHomeCards() {
      const grid = document.getElementById('home-cards');
      const t = I18N[window.currentLang];
      
      // 上下左右的类名
      const shapes = ['shape-top', 'shape-right', 'shape-bottom', 'shape-left'];
      const targets = ['view-literature', 'view-published', 'view-music', 'view-games'];
      const icons = [
        `<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M8 7h6"/><path d="M8 11h8"/>`,
        `<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="m9 9 2 2 4-4"/>`,
        `<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>`,
        `<line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><rect x="2" y2="6" width="20" height="12" rx="2"/>`
      ];
      const titles = [t.lit.title, t.pub.title, t.mus.title, t.gam.title];

      grid.innerHTML = '';
      for (let i = 0; i < 4; i++) {
        const a = document.createElement('a');
        a.href = 'javascript:void(0);';
        a.className = `glass-block ${shapes[i]}`;
        a.innerHTML = `
          <div class="block-content">
            <div class="block-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">${icons[i]}</svg>
            </div>
            <h2 class="block-title">${titles[i]}</h2>
          </div>
        `;
        a.addEventListener('click', () => openMegaModal(targets[i]));
        grid.appendChild(a);
      }
    }

    renderHomeCards();
    window.updateLanguage = () => { renderHomeCards(); };

    document.addEventListener('videoEnded', () => {
      document.querySelectorAll('.glass-block').forEach((el, index) => {
        setTimeout(() => { el.classList.add('leaf-pop'); }, index * 150); 
      });
    });


    // ================= 3. 大弹窗与详情小弹窗控制 =================
    const megaModal = document.getElementById('mega-modal');
    const modalTitle = document.getElementById('modal-title');
    const megaListContainer = document.getElementById('mega-list-container');
    const megaMusicPlayer = document.getElementById('mega-music-player');
    const readerView = document.getElementById('reader-view');
    const detailModal = document.getElementById('detail-modal');

    function openMegaModal(targetId) {
      megaModal.classList.add('active');
      megaListContainer.innerHTML = '';
      megaListContainer.style.display = 'flex';
      megaMusicPlayer.classList.remove('show');
      readerView.classList.remove('show');
      
      const t = I18N[window.currentLang];
      const lang = window.currentLang;

      if (targetId === 'view-literature') {
        modalTitle.textContent = t.lit.title;
        fetch(`/books_${lang}.json`).then(r => r.json()).then(data => renderList(data, true));
      } else if (targetId === 'view-published') {
        modalTitle.textContent = t.pub.title;
        fetch(`/published_${lang}.json`).then(r => r.json()).then(data => renderList(data, false));
      } else if (targetId === 'view-games') {
        modalTitle.textContent = t.gam.title;
        fetch(`/games_${lang}.json`).then(r => r.json()).then(data => renderList(data, false));
      } else if (targetId === 'view-music') {
        modalTitle.textContent = t.mus.title;
        megaListContainer.style.display = 'none'; 
        megaMusicPlayer.classList.add('show');    
        document.getElementById('music-label').textContent = t.chooseSong;
        initMusicSelect(lang); 
      }
    }

    window.openMusicModal = () => { openMegaModal('view-music'); };
    document.getElementById('close-mega-modal').onclick = () => { megaModal.classList.remove('active'); };
    document.getElementById('back-to-list').onclick = () => { readerView.classList.remove('show'); megaListContainer.style.display = 'flex'; };

    // 打开详情小弹窗
    function openDetailModal(item, isBook) {
      document.getElementById('detail-title').textContent = item.title;
      document.getElementById('detail-desc').innerHTML = item.desc || item.content || '';
      
      const readBtn = document.getElementById('detail-read-btn');
      if (isBook) {
        readBtn.style.display = 'block';
        readBtn.textContent = I18N[window.currentLang].read;
        readBtn.onclick = () => { 
          detailModal.classList.remove('active'); 
          openBook(item.title); 
        };
      } else {
        readBtn.style.display = 'none';
      }
      detailModal.classList.add('active');
    }
    document.getElementById('close-detail-modal').onclick = () => { detailModal.classList.remove('active'); };

    // 渲染扁平的列表
    function renderList(dataList, isBook) {
      megaListContainer.innerHTML = '';
      dataList.forEach(item => {
        const wrapper = document.createElement('div');
        wrapper.className = 'shutter-item';
        wrapper.innerHTML = `<div class="item-title">${item.title}</div><div class="item-subtitle">${item.subtitle || item.type || ''}</div>`;
        wrapper.addEventListener('click', () => openDetailModal(item, isBook));
        megaListContainer.appendChild(wrapper);
      });
    }


    // ================= 4. 电子书阅读器 =================
    let currentRendition = null;
    const loadingEl = document.getElementById('loading');
    const B2_BOOK_URL = "https://f005.backblazeb2.com/file/hypoaqua/book/";

    function openBook(title) {
      megaListContainer.style.display = 'none';
      readerView.classList.add('show');
      loadingEl.style.display = "flex";

      const epubUrl = B2_BOOK_URL + encodeURIComponent(title) + ".epub";
      if (currentRendition) currentRendition.destroy();

      setTimeout(() => {
        const bookObj = ePub(epubUrl);
        currentRendition = bookObj.renderTo("viewer", { width: "100%", height: "100%", spread: "always", flow: "paginated" });
        currentRendition.themes.default({
          'body': { 'color': '#1e293b !important', 'background': 'transparent !important', 'font-family': '"Andada Pro", "LXGW Heart Serif", serif !important', 'font-size': '1.1rem !important' },
          'p': { 'line-height': '2 !important', 'margin-bottom': '1.2em !important', 'text-indent': '2em !important' }
        });
        currentRendition.display().then(() => loadingEl.style.display = "none").catch(() => loadingEl.innerHTML = "加载失败，请检查文件名或CORS");
        document.getElementById("prev-btn").onclick = () => currentRendition.prev();
        document.getElementById("next-btn").onclick = () => currentRendition.next();
      }, 100);
    }


    // ================= 5. 音乐播放器 (中英完美匹配) =================
    const B2_MUSIC_URL = "https://f005.backblazeb2.com/file/hypoaqua/music/";
    const selectEl = document.getElementById('music-select');
    const audioPlayer = document.getElementById('global-audio'); 
    const progressBar = document.getElementById('progress-bar');
    const currentTimeEl = document.getElementById('current-time');
    const totalTimeEl = document.getElementById('total-time');
    let isDragging = false;
    let musicListCurrent = []; 
    let musicListZh = [];      

    function formatTime(seconds) {
      if (isNaN(seconds)) return "00:00";
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    async function initMusicSelect(lang) {
      try {
        const resZh = await fetch('/music_zh.json');
        musicListZh = await resZh.json();
        const resCur = await fetch(`/music_${lang}.json`);
        musicListCurrent = await resCur.json();

        selectEl.innerHTML = '<option value="">---</option>';
        musicListCurrent.forEach((item, index) => {
          const opt = document.createElement('option');
          opt.value = index; 
          opt.textContent = item.name; 
          selectEl.appendChild(opt);
        });
      } catch (err) {
        console.error("加载音乐列表失败", err);
      }
    }

    function playMusic(index) {
      if (index === "" || !musicListZh[index]) return;
      const realFileName = musicListZh[index].name; 
      const displayName = musicListCurrent[index].name;
      
      audioPlayer.src = B2_MUSIC_URL + encodeURIComponent(realFileName) + '.mp3';
      audioPlayer.play().catch(e => console.log(e));
      progressBar.value = 0; currentTimeEl.textContent = "00:00";
      
      if (window.updateMusicWidget) window.updateMusicWidget(true, displayName);
    }

    selectEl.addEventListener('change', (e) => playMusic(e.target.value));
    
    document.getElementById('play-pause-btn').addEventListener('click', () => {
      if (!audioPlayer.src) { 
        if (musicListCurrent.length > 0) { selectEl.value = 0; playMusic(0); }
        return; 
      }
      if (audioPlayer.paused) audioPlayer.play();
      else audioPlayer.pause();
    });

    audioPlayer.addEventListener('play', () => { 
      const vinyl = document.getElementById('vinyl');
      const btn = document.getElementById('play-pause-btn');
      if(vinyl) vinyl.classList.add('playing');
      if(btn) btn.classList.add('playing');
      if (window.updateMusicWidget) window.updateMusicWidget(true, document.getElementById('orb-song-name').textContent);
    });

    audioPlayer.addEventListener('pause', () => { 
      const vinyl = document.getElementById('vinyl');
      const btn = document.getElementById('play-pause-btn');
      if(vinyl) vinyl.classList.remove('playing');
      if(btn) btn.classList.remove('playing');
      if (window.updateMusicWidget) window.updateMusicWidget(false, document.getElementById('orb-song-name').textContent);
    });

    audioPlayer.addEventListener('loadedmetadata', () => {
      totalTimeEl.textContent = formatTime(audioPlayer.duration);
      progressBar.max = Math.floor(audioPlayer.duration);
    });
    
    audioPlayer.addEventListener('timeupdate', () => {
      if (!isDragging) {
        progressBar.value = Math.floor(audioPlayer.currentTime);
        currentTimeEl.textContent = formatTime(audioPlayer.currentTime);
      }
    });
    
    progressBar.addEventListener('mousedown', () => isDragging = true);
    progressBar.addEventListener('touchstart', () => isDragging = true);
    progressBar.addEventListener('input', (e) => currentTimeEl.textContent = formatTime(e.target.value));
    progressBar.addEventListener('change', (e) => { audioPlayer.currentTime = e.target.value; isDragging = false; });
    
    audioPlayer.addEventListener('ended', () => {
      const currentIndex = parseInt(selectEl.value);
      if (isNaN(currentIndex) || musicListCurrent.length === 0) return;
      const nextIndex = (currentIndex + 1) % musicListCurrent.length;
      selectEl.value = nextIndex; 
      playMusic(nextIndex);
    });

  });
</script>